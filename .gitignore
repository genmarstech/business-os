# Python
# collectstatic output — generated at image build time.
staticfiles/

__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments. `virtual/` is the one this project uses.
virtual/
.venv/
venv/

# ── THE DEVELOPMENT DATABASE ────────────────────────────────────────────────
#
# backend/db.sqlite3 was committed. It is a developer's local database: it
# drifts from the migrations, it makes every branch conflict on a binary file,
# and on a product that holds other companies' staff records it is the kind of
# file that ends up carrying real data into a public repository by accident.
#
# This repo is PUBLIC. Migrations are the schema; the database is not.
*.sqlite3
db.sqlite3

# Secrets. The sign-on client secret belongs in the environment and is shown
# exactly once when issued — see backend/identity/README.md.
.env
*.env
!.env.example

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/

# ── DATABASE DUMPS NEVER GO IN GIT ──────────────────────────────────────────
# scripts/backup.sh writes here, and compose.yaml bind-mounts it into the db
# container. The contents are every subscriber's sales, refunds, staff and
# stock — other people's businesses.
#
# git does not forget. A dump committed once is in the history of every clone
# forever, and removing it means rewriting history everybody has already
# pulled. The ignore is the only cheap moment to get this right.
backups/
*.dump
*.dump.gpg

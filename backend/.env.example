# Business Platform — production environment.
#
# Copy to .env, fill in, and never commit it. This repository is PUBLIC.
#
#   cp backend/.env.example backend/.env

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=False

# Generate a fresh one. The key in this repository's history is public and must
# never be used:  python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

ALLOWED_HOSTS=business.genmars.co.ke
CSRF_TRUSTED_ORIGINS=https://business.genmars.co.ke

# Postgres. SQLite is refused outside DEBUG: two tills writing at the same
# moment is the normal case for a POS.
DATABASE_URL=postgres://user:password@db:5432/business_platform

# ── The Genmars handoff ─────────────────────────────────────────────────────
#
# Issued in ops → Settings → Engineering → Sibling sign-in. The secret is shown
# EXACTLY ONCE and can only be replaced, never recovered.
#
# Register it against the BUSINESS PLATFORM's own system entry, and set the
# audience to "Any verified account, staff or client". Both were wrong on the
# first attempt and neither failed loudly: a registration attached to another
# system makes the consent screen name that other application, and the default
# audience — "Genmars staff only" — is enforced by SignOnApp.admits() as
# `bool(user.is_staff)`, which refuses every subscriber this product is sold
# to while working perfectly for whoever is testing it.
#
# The redirect must match what is registered there character for character —
# the portal compares the whole string, never a prefix, because prefix matching
# is how https://business.genmars.co.ke.attacker.com/… gets accepted.
GENMARS_SIGN_ON_CLIENT_ID=
GENMARS_SIGN_ON_CLIENT_SECRET=
GENMARS_SIGN_ON_REDIRECT_URI=https://business.genmars.co.ke/auth/callback

# Defaults are correct for production; set them only to build against staging.
# GENMARS_PORTAL_ORIGIN=https://app.genmars.co.ke
# GENMARS_API_ORIGIN=https://api.genmars.co.ke

# ── Where staff are told to go on their first day ───────────────────────────
#
# The address in the invitation email. Read by somebody who has just been told
# it is where they work, so WRONG here is worse than absent: a stale value is
# a shop's staff typing an address that is not ours into a phone.
#
# The default is correct for production. Set it when you are standing up a
# second host, and set it to that host — not to this one.
# TILL_SIGN_IN_URL=https://business.genmars.co.ke/till

# ── Email ───────────────────────────────────────────────────────────────────
#
# ⚠ MAIL IS NOW LOAD-BEARING FOR ONBOARDING, NOT ONLY FOR RECOVERY.
#
# This said "nothing sends mail yet". It does: creating a till login emails
# the employee a setup code, and that code is the ONLY way into a login
# created without a password — which is the default, because it is the path
# where no manager ever knows the password.
#
# So a host without working mail cannot put anybody on a till the intended
# way. It fails loudly rather than silently (the create response reports the
# send), and a manager can fall back to typing a password, but a shop that
# does that has lost the property the whole flow exists for.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Issued in ops under Settings → Engineering. Lets this installation report
# its own health to the Genmars system registry, and nothing else — the
# direction of trust is inward only. Absent means simply not registered.
GENMARS_SYSTEM_KEY=
# The commit the running image was built from, so the dashboard can say which
# version is live.
APP_VERSION=

# ─────────────────────────────────────────────────────────────────────────────
# Genmars Business Platform — business.genmars.co.ke
#
# A DROP-IN for the shared host Caddy, not a standalone config.
#
#   sudo cp deploy/business.caddy /etc/caddy/conf.d/business.caddy
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#   systemctl is-active caddy        # NOT optional — see below
#
# ⚠ DO NOT copy this over /etc/caddy/Caddyfile. That host also serves
#   genmars.co.ke, app/api/ops.genmars.co.ke and clipsserenityspa.co.ke — a
#   LIVE CLIENT SITE. The main Caddyfile does nothing but
#   `import /etc/caddy/conf.d/*.caddy`; overwriting it takes all of them down.
#
# `caddy validate` passing is necessary but NOT sufficient. Some failures
# happen at load rather than at adapt, so validate passes and only the reload
# breaks. Check the service afterwards.
#
# ⚠ DNS FOR business.genmars.co.ke ALREADY POINTS HERE AND NOTHING SERVES IT.
#   Until this block exists, a request gets a 308 to https and then fails TLS,
#   because Caddy has no certificate for a name it has never been asked about.
#   Installing this is what triggers issuance.
#
# ⚠ KEEP THE RECORD DNS-ONLY (GREY CLOUD) IN CLOUDFLARE, like app/api/ops.
#   Proxied, Cloudflare terminates TLS and every request — including a
#   cashier's password and a sign-on code that becomes somebody's identity —
#   is readable at its edge. It also breaks per-IP rate limiting, because
#   every request would arrive from Cloudflare.
# ─────────────────────────────────────────────────────────────────────────────

business.genmars.co.ke {
	encode zstd gzip

	# ── Django admin and DRF assets, served straight off disk ───────────────
	#
	# Static files have no business travelling through gunicorn, where each one
	# occupies a worker that should be answering API requests.
	#
	# `handle_path`, NOT `handle`. STATIC_URL is /static/ but collectstatic
	# writes to staticfiles/ — the URL prefix and the directory name differ and
	# always will. handle_path strips the matched prefix, so
	# /static/admin/css/base.css resolves to staticfiles/admin/css/base.css.
	# With plain `handle` and `root * /opt/business-os` this looks right and
	# serves nothing: Caddy goes looking for /opt/business-os/static/, which
	# does not exist. gen-portal shipped exactly that bug; the symptom is an
	# unstyled admin, a 404 in the browser console, and nothing whatsoever in
	# the Caddy or Django logs to say why.
	#
	# ⚠ THE DIRECTORY IS COPIED OUT OF THE IMAGE, NOT BIND-MOUNTED IN.
	#   See the note in compose.yaml. It is empty until a deploy runs
	#   `docker compose cp api:/app/staticfiles ./staticfiles`, and an empty
	#   directory here is an unstyled admin, not an error.
	handle_path /static/* {
		root * /opt/business-os/staticfiles
		file_server
	}

	# ── THE API AND THE SIGN-ON DOORS ───────────────────────────────────────
	#
	# Django owns these prefixes and only these. Everything else is the web
	# application below.
	#
	# ⚠ ONE HOST, NOT TWO, AND THAT IS LOAD-BEARING.
	#   /auth/callback sets a Django session cookie on business.genmars.co.ke
	#   with NO Domain attribute, so the browser scopes it to this exact host
	#   — the same property that keeps portal and ops sessions apart, and the
	#   reason SESSION_COOKIE_DOMAIN must never be set. Serve the application
	#   from a different origin and that cookie stops travelling, which
	#   presents as "signing in does nothing" with no error anywhere.
	#
	# X-Real-IP is what identity/authentication.py and any future rate limit
	# read to tell one caller from another. Without it every request arrives
	# from the proxy and a per-address limit becomes one shared budget —
	# exactly the bug gen-portal shipped and had to fix.
	@api path /auth/* /org/* /brn/* /ctl/* /invt/* /sls/* /admin/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8020 {
			header_up X-Real-IP {remote_host}

			# Takes the app out of rotation if it stops answering.
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
		}
	}

	# ── THE WEB APPLICATION ─────────────────────────────────────────────────
	#
	# Next.js, published to loopback only like the API. It renders on the
	# server and forwards the same session cookie to Django itself over the
	# compose network — see frontend/src/lib/api.ts.
	#
	# ORDER MATTERS: a `handle` with no matcher swallows everything, so it
	# comes last. Put it above the two blocks before it and neither /static/*
	# nor a single API call would ever arrive where it belongs.
	#
	# Its health check is the app's OWN /healthz on 3030, which is a different
	# route from the /healthz above: that one is matched by @api and goes to
	# Django. Two processes, two liveness checks, one path spelling.
	handle {
		reverse_proxy 127.0.0.1:3030 {
			header_up X-Real-IP {remote_host}

			health_uri /healthz
			health_interval 10s
			health_timeout 3s
		}
	}

	header {
		# Do not advertise the server.
		-Server

		# HSTS belongs at the TLS edge, not in the application — it is
		# meaningless on the plain-HTTP hop behind this.
		#
		# Deliberately WITHOUT includeSubDomains and WITHOUT preload. Both are
		# hard to reverse: preload is a long manual removal baked into
		# browsers, and includeSubDomains breaks any subdomain not yet on
		# HTTPS.
		Strict-Transport-Security "max-age=31536000"

		# This is somebody's business data — their takings, their stock, their
		# staff. It has no business in a search index.
		X-Robots-Tag "noindex, nofollow"

		# ⚠ FRAME PROTECTION IS NOT OPTIONAL HERE.
		#
		# ops.genmars.co.ke shipped without it and ran that way for weeks. A
		# POS dashboard is worse: an invisible iframe over an attacker's page
		# collects clicks from somebody signed in to a till, and the controls
		# behind those clicks move stock and cash.
		X-Frame-Options "DENY"

		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# ── Content-Security-Policy ──────────────────────────────────────────────
	#
	# Deliberately absent until there is a frontend to test it against. This is
	# an API today; a CSP written now would be guesswork about markup that does
	# not exist, and the failure mode of a wrong CSP is a blank screen nobody
	# notices until somebody opens the page that uses the blocked thing.
	#
	# When the dashboard lands: ship it Report-Only first, walk every screen
	# with the console open, then rename the header. ops.caddy has the same
	# note and the same reasoning.

	# ── LOGGING ──────────────────────────────────────────────────────────────
	# Intentionally absent, like every other site on this host. A
	# `log { output file … }` block FAILS at reload with permission denied even
	# after chown — and because it fails at load rather than at adapt time,
	# `caddy validate` passes and only the reload breaks. Access logs go to the
	# journal, which also keeps retention in one place: they contain caller IP
	# addresses, and a retention period has to be one we can state truthfully.
}
